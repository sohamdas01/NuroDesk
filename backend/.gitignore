# ========================================
# NuroDesk Backend - .gitignore
# ========================================

# ===== Dependencies =====
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ===== Environment Variables =====
.env
.env.local
.env.development
.env.production
!.env.example

# ===== User Data =====
data/users.json
data/*.json
!data/.gitkeep

# ===== Upload & Temp Directories =====
uploads/*
!uploads/.gitkeep
temp/
temp_audio/
temp_ocr/
temp_captions/
temp_*/

# ===== Generated Files =====
*-player-script.js
player-*.js

# ===== Cookies & Auth =====
cookies.txt
youtube_cookies.txt
*.cookies

# ===== Binaries & Executables =====
yt-dlp.exe
yt-dlp
ffmpeg.exe
ffmpeg

# ===== Tesseract OCR Data =====
eng.traineddata
*.traineddata

# ===== Logs =====
logs/
*.log
pnpm-debug.log*

# ===== OS Files =====
.DS_Store
Thumbs.db
desktop.ini

# ===== IDE & Editors =====
.vscode/
.idea/
*.swp
*.swo

# ===== Build Outputs =====
dist/
build/

# ===== Database Files (if using local) =====
*.sqlite
*.sqlite3
*.db

# ===== Backup Files =====
*.bak
*.backup
*.old

# ===== Keep These (with .gitkeep) =====
!data/.gitkeep
!uploads/.gitkeep
!temp/.gitkeep